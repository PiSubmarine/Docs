(* ::Package:: *)

scriptDirectory = Which[
   StringLength[$InputFileName] > 0, DirectoryName[$InputFileName],
   True, NotebookDirectory[]
   ];

dotFile = FileNameJoin[{scriptDirectory, "Repository Dependency Graph.dot"}];
dotText = Import[dotFile, "Text"];

lines = StringSplit[dotText, {"\r\n", "\n", "\r"}];
edgeLines = Select[
   StringTrim /@ lines,
   StringContainsQ[#, "->"] &
   ];

parseEdge[line_] := Module[{matches},
   matches = StringCases[
     line,
     RegularExpression[
        "^\\s*\"([^\"]+)\"\\s*->\\s*\"([^\"]+)\"\\s*(\\[[^\\]]*\\])?\\s*;\\s*$"
        ] :> {"$1", "$2", "$3"}
     ];

   If[matches === {},
    Missing["InvalidEdge", line],
    <|
     "Source" -> matches[[1, 1]],
     "Target" -> matches[[1, 2]],
     "Attributes" -> matches[[1, 3]]
     |>
    ]
   ];

parsedEdges = DeleteMissing[parseEdge /@ edgeLines];

allEdges = Map[
   DirectedEdge[#["Source"], #["Target"]] &,
   parsedEdges
   ];

edgeStyles = Map[
    Function[entry,
      With[
       {
        edge = DirectedEdge[entry["Source"], entry["Target"]],
        attrs = entry["Attributes"]
        },
       Which[
        StringContainsQ[attrs, "label=\"app\""],
        edge -> Directive[Dashed, Blue],
        StringContainsQ[attrs, "label=\"test\""],
        edge -> Directive[Dashed, Darker[Green]],
        True,
        edge -> Directive[GrayLevel[0.35]]
       ]
       ]
      ],
    parsedEdges
    ];

vertexList = DeleteDuplicates @ Flatten[List @@@ allEdges];

vertexStyles = Thread[vertexList -> White];

Graph[
 allEdges,
 VertexLabels -> Placed["Name", Center],
 VertexStyle -> vertexStyles,
 EdgeStyle -> edgeStyles,
 GraphLayout -> {"LayeredDigraphEmbedding", "Orientation" -> Left},
 ImageSize -> Large
 ]


